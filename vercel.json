{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/bienvenida.html"
    },
    {
      "source": "/directorio",
      "destination": "/index.html"
    },
    {
      "source": "/eventos",
      "destination": "/eventos.html"
    },
    {
      "source": "/empleos",
      "destination": "/empleos/index.html"
    }
  ]
}
